# Copy values into ignored local process environment. Never commit real keys.
AUTH_DB_URL=jdbc:postgresql://127.0.0.1:15432/devfield_dev?currentSchema=auth
AUTH_DB_USER=devfield_auth
AUTH_DB_PASSWORD=<from RepoQ local environment>
AUTH_ISSUER=http://127.0.0.1:18080
AUTH_AUDIENCE=devfield-user-api-local
AUTH_JWT_TTL=PT5M
AUTH_SESSION_TTL=P1D
AUTH_VERIFICATION_TTL=PT30M
AUTH_SIGNUP_COOLDOWN=PT1M
AUTH_MAX_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW=PT15M
AUTH_PRIVATE_KEY_PATH=<absolute path under .local>
AUTH_PUBLIC_KEY_PATH=<absolute path under .local>
AUTH_WEB_VERIFY_URL=http://localhost:13000/verify-email
AUTH_MAIL_FROM=devfield-local@example.test
AUTH_SMTP_HOST=127.0.0.1
AUTH_SMTP_PORT=11025
AUTH_BFF_KEY_SHA256=<sha256 hex of BFF key>
AUTH_PROJECT_KEY_SHA256=<sha256 hex of Project key>
AUTH_INTERVIEW_KEY_SHA256=<sha256 hex of Interview key>
AUTH_BROWSER_ORIGIN=http://127.0.0.1:18080
AUTH_WEB_OAUTH_CALLBACK=http://localhost:13000/auth/oauth/callback
AUTH_OAUTH_CONTEXT_KEY=<base64-encoded 32-byte key in ignored local environment>
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_KAKAO_CLIENT_ID=
AUTH_KAKAO_CLIENT_SECRET=
